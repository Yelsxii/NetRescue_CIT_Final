APP_NAME="NetRescue CIT"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Manila

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=netrescue_db
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync

NETRESCUE_DNS_TEST_DOMAIN=example.com
NETRESCUE_INTERNET_TARGETS="1.1.1.1:443,8.8.8.8:53"
NETRESCUE_DEFAULT_INTERVAL=5
NETRESCUE_LATENCY_WARNING_MS=100

NETRESCUE_AGENT_OFFLINE_AFTER=3
NETRESCUE_AGENT_COMMAND_EXPIRY=10

# Optional: force the exact LAN/HTTPS URL embedded in one-click endpoint installers.
# Leave blank to let NetRescue detect the Central host's LAN address automatically.
NETRESCUE_CENTRAL_URL=
